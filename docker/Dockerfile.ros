# ROS2 Jazzy image for the Warehouse Digital Twin simulation + fleet.
#
# Includes the ROS core, Gazebo, the full robot stack (localization,
# planning, control, task manager, fleet beacon), the Control Center and the
# backend ingest bridge. The whole ROS graph runs in one container so topics
# never cross container boundaries.
#
# Build:  docker build -f docker/Dockerfile.ros -t warehouse-ros .
# Run:    docker run -it --rm warehouse-ros ros2 launch warehouse_bringup warehouse.launch.py

FROM ros:jazzy-ros-base

ENV DEBIAN_FRONTEND=noninteractive
ENV TURTLEBOT3_MODEL=burger

# Gazebo (Harmonic) + ROS-Gazebo integration + build tools.
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3-colcon-common-extensions \
    python3-pytest \
    ros-jazzy-gazebo-ros-pkgs \
    ros-jazzy-ros-gz \
    ros-jazzy-xacro \
    curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /ros2_ws

# Copy the ROS workspace and build it (package source + launch + config).
COPY ros2_ws/ /ros2_ws/
RUN bash -c 'source /opt/ros/jazzy/setup.bash && colcon build --symlink-install'

# Headless-friendly entrypoint: source the workspace then run the given command.
ENTRYPOINT ["/bin/bash", "-c", \
  "source /opt/ros/jazzy/setup.bash && source /ros2_ws/install/setup.bash && exec \"$@\"", \
  "warehouse"]
