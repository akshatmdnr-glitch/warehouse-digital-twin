<?xml version="1.0" ?>
<!--
  Warehouse World — realistic 3D warehouse for the digital twin.

  Layout (world centred at origin, 20m x 20m, walls at +/-10 m):
    * 9 racks in a 3x3 grid (rows A/B/C, columns 1/2/3) with ID signs
    * 2 m row aisles, 2 m column gaps, 5 m end aisles
    * south zone: pickup / dropoff stations + robot2 charging pad
    * north zone: robot1 charging pad
    * east wall:  loading dock with bay + pallets
    * static pallets / crates / packages placed off the navigation lanes

  Navigation map: maps/warehouse_world.pgm (regenerated to match exactly).
-->
<sdf version="1.6">
  <world name="warehouse_world">

    <!-- ===== Physics (dartsim engine — must be a valid gz-physics engine) ===== -->
    <physics name="warehouse_physics" type="dartsim">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <!-- ===== Required System Plugins ===== -->
    <plugin
      filename="gz-sim-physics-system"
      name="gz::sim::systems::Physics">
    </plugin>
    <plugin
      filename="gz-sim-user-commands-system"
      name="gz::sim::systems::UserCommands">
    </plugin>
    <plugin
      filename="gz-sim-scene-broadcaster-system"
      name="gz::sim::systems::SceneBroadcaster">
    </plugin>
    <plugin
      filename="gz-sim-contact-system"
      name="gz::sim::systems::Contact">
    </plugin>
    <plugin
      filename="gz-sim-sensors-system"
      name="gz::sim::systems::Sensors">
    </plugin>

    <!-- ===== Scene / ambient light ===== -->
    <scene>
      <ambient>0.42 0.42 0.46 1</ambient>
      <background>0.18 0.21 0.26 1</background>
      <shadows>true</shadows>
    </scene>

    <!-- ===== Lighting ===== -->
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.85 0.85 0.82 1</diffuse>
      <specular>0.3 0.3 0.3 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.15 -0.9</direction>
    </light>

    <!-- Fill light from the opposite side (kills harsh shadows) -->
    <light type="directional" name="fill_light">
      <cast_shadows>false</cast_shadows>
      <pose>0 0 8 0 0 0</pose>
      <diffuse>0.4 0.4 0.45 1</diffuse>
      <specular>0.1 0.1 0.1 1</specular>
      <direction>0.6 -0.2 -0.8</direction>
    </light>

    <!-- Overhead work light over the rack grid -->
    <light type="point" name="overhead_light">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.35 0.35 0.4 1</diffuse>
      <specular>0.15 0.15 0.15 1</specular>
      <attenuation>
        <range>60</range>
        <constant>0.3</constant>
        <linear>0.02</linear>
        <quadratic>0.002</quadratic>
      </attenuation>
    </light>

    <!-- ===== Ground ===== -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
        </collision>
      </link>
    </model>

    <!-- ===== Warehouse Floor ===== -->
    <model name="warehouse_floor">
      <static>true</static>
      <pose>0 0 0 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>20 20 0.02</size></box></geometry>
          <material>
            <ambient>0.35 0.36 0.38 1</ambient>
            <diffuse>0.52 0.54 0.56 1</diffuse>
            <specular>0.12 0.12 0.12 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- Floor lane markings (visual guides for the aisles) -->
    <model name="floor_markings">
      <static>true</static>
      <link name="link">
        <visual name="stripe_a">
          <pose>0 2.5 0.012 0 0 0</pose>
          <geometry><box><size>19.5 0.08 0.004</size></box></geometry>
          <material>
            <ambient>0.6 0.55 0.1 1</ambient>
            <diffuse>0.85 0.78 0.18 1</diffuse>
          </material>
        </visual>
        <visual name="stripe_b">
          <pose>0 -2.5 0.012 0 0 0</pose>
          <geometry><box><size>19.5 0.08 0.004</size></box></geometry>
          <material>
            <ambient>0.6 0.55 0.1 1</ambient>
            <diffuse>0.85 0.78 0.18 1</diffuse>
          </material>
        </visual>
        <visual name="stripe_east">
          <pose>7.5 0 0.012 0 0 0</pose>
          <geometry><box><size>0.08 20 0.004</size></box></geometry>
          <material>
            <ambient>0.6 0.55 0.1 1</ambient>
            <diffuse>0.85 0.78 0.18 1</diffuse>
          </material>
        </visual>
        <visual name="stripe_west">
          <pose>-7.5 0 0.012 0 0 0</pose>
          <geometry><box><size>0.08 20 0.004</size></box></geometry>
          <material>
            <ambient>0.6 0.55 0.1 1</ambient>
            <diffuse>0.85 0.78 0.18 1</diffuse>
          </material>
        </visual>
        <visual name="stripe_dock">
          <pose>7.5 0 0.012 0 0 0</pose>
          <geometry><box><size>0.08 3.4 0.004</size></box></geometry>
          <material>
            <ambient>0.5 0.45 0.08 1</ambient>
            <diffuse>0.8 0.72 0.15 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- ===== Walls ===== -->
    <model name="north_wall">
      <static>true</static>
      <pose>0 10 2 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>20 0.2 4</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>20 0.2 4</size></box></geometry>
          <material>
            <ambient>0.62 0.6 0.55 1</ambient>
            <diffuse>0.68 0.66 0.6 1</diffuse>
            <specular>0.05 0.05 0.05 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <model name="south_wall">
      <static>true</static>
      <pose>0 -10 2 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>20 0.2 4</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>20 0.2 4</size></box></geometry>
          <material>
            <ambient>0.62 0.6 0.55 1</ambient>
            <diffuse>0.68 0.66 0.6 1</diffuse>
            <specular>0.05 0.05 0.05 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <model name="east_wall">
      <static>true</static>
      <pose>10 0 2 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.2 20 4</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.2 20 4</size></box></geometry>
          <material>
            <ambient>0.62 0.6 0.55 1</ambient>
            <diffuse>0.68 0.66 0.6 1</diffuse>
            <specular>0.05 0.05 0.05 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <model name="west_wall">
      <static>true</static>
      <pose>-10 0 2 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.2 20 4</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.2 20 4</size></box></geometry>
          <material>
            <ambient>0.62 0.6 0.55 1</ambient>
            <diffuse>0.68 0.66 0.6 1</diffuse>
            <specular>0.05 0.05 0.05 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- ===== Racks (3 rows x 3 columns) with ID signs ===== -->
    <!-- A1 --> <include><name>rack_a1</name><pose>-4 3 0 0 0 0</pose><uri>model://rack</uri></include>
    <!-- A2 --> <include><name>rack_a2</name><pose> 0 3 0 0 0 0</pose><uri>model://rack</uri></include>
    <!-- A3 --> <include><name>rack_a3</name><pose> 4 3 0 0 0 0</pose><uri>model://rack</uri></include>
    <!-- B1 --> <include><name>rack_b1</name><pose>-4 0 0 0 0 0</pose><uri>model://rack</uri></include>
    <!-- B2 --> <include><name>rack_b2</name><pose> 0 0 0 0 0 0</pose><uri>model://rack</uri></include>
    <!-- B3 --> <include><name>rack_b3</name><pose> 4 0 0 0 0 0</pose><uri>model://rack</uri></include>
    <!-- C1 --> <include><name>rack_c1</name><pose>-4 -3 0 0 0 0</pose><uri>model://rack</uri></include>
    <!-- C2 --> <include><name>rack_c2</name><pose> 0 -3 0 0 0 0</pose><uri>model://rack</uri></include>
    <!-- C3 --> <include><name>rack_c3</name><pose> 4 -3 0 0 0 0</pose><uri>model://rack</uri></include>

    <!-- Rack ID signs mounted above each rack -->
    <include><name>sign_a1</name><pose>-4 3 2.3 0 0 0</pose><uri>model://rack_sign_A1</uri></include>
    <include><name>sign_a2</name><pose> 0 3 2.3 0 0 0</pose><uri>model://rack_sign_A2</uri></include>
    <include><name>sign_a3</name><pose> 4 3 2.3 0 0 0</pose><uri>model://rack_sign_A3</uri></include>
    <include><name>sign_b1</name><pose>-4 0 2.3 0 0 0</pose><uri>model://rack_sign_B1</uri></include>
    <include><name>sign_b2</name><pose> 0 0 2.3 0 0 0</pose><uri>model://rack_sign_B2</uri></include>
    <include><name>sign_b3</name><pose> 4 0 2.3 0 0 0</pose><uri>model://rack_sign_B3</uri></include>
    <include><name>sign_c1</name><pose>-4 -3 2.3 0 0 0</pose><uri>model://rack_sign_C1</uri></include>
    <include><name>sign_c2</name><pose> 0 -3 2.3 0 0 0</pose><uri>model://rack_sign_C2</uri></include>
    <include><name>sign_c3</name><pose> 4 -3 2.3 0 0 0</pose><uri>model://rack_sign_C3</uri></include>

    <!-- ===== Loading dock (east wall) + pallets on the platform ===== -->
    <include><name>loading_dock</name><pose>8.5 0 0 0 0 0</pose><uri>model://loading_dock</uri></include>
    <include><name>dock_pallet_1</name><pose>8.5 -0.7 1.0 0 0 0</pose><uri>model://pallet</uri></include>
    <include><name>dock_pallet_2</name><pose>8.5 0.7 1.0 0 0 0</pose><uri>model://pallet</uri></include>
    <include><name>dock_crate</name><pose>8.5 0 1.0 0 0 0.4</pose><uri>model://crate</uri></include>

    <!-- ===== Pickup / dropoff stations (south zone) ===== -->
    <include><name>pickup_station</name><pose>-2 -7 0 0 0 0</pose><uri>model://pickup_station</uri></include>
    <include><name>dropoff_station</name><pose> 2 -7 0 0 0 0</pose><uri>model://dropoff_station</uri></include>

    <!-- ===== Charging stations (robot1 north, robot2 south) ===== -->
    <include><name>charging_north</name><pose>0 8 0 0 0 0</pose><uri>model://charging_station</uri></include>
    <include><name>charging_south</name><pose>0 -8 0 0 0 0</pose><uri>model://charging_station</uri></include>

    <!-- ===== Static pallets (off-lane) ===== -->
    <include><name>pallet_ne</name><pose> 7 8 0 0 0 0</pose><uri>model://pallet</uri></include>
    <include><name>pallet_nw</name><pose>-7 8 0 0 0 0</pose><uri>model://pallet</uri></include>
    <include><name>pallet_se</name><pose> 6 -8 0 0 0 0</pose><uri>model://pallet</uri></include>
    <include><name>pallet_sw</name><pose>-6 -8 0 0 0 0</pose><uri>model://pallet</uri></include>

    <!-- ===== Crates (off-lane) ===== -->
    <include><name>crate_ne</name><pose> 7 6 0 0 0 0</pose><uri>model://crate</uri></include>
    <include><name>crate_nw</name><pose>-7 6 0 0 0 0</pose><uri>model://crate</uri></include>
    <include><name>crate_se</name><pose> 7 -6 0 0 0 0</pose><uri>model://crate</uri></include>
    <include><name>crate_sw</name><pose>-7 -6 0 0 0 0</pose><uri>model://crate</uri></include>

    <!-- ===== Loose packages ===== -->
    <include><name>package_1</name><pose> 3 -6 0 0 0 0.3</pose><uri>model://package</uri></include>
    <include><name>package_2</name><pose>-3 -6 0 0 0 0.1</pose><uri>model://package</uri></include>
    <include><name>package_3</name><pose> 9.4 -5 0 0 0 -0.2</pose><uri>model://package</uri></include>
    <include><name>package_4</name><pose>-9.4 -5 0 0 0 0.2</pose><uri>model://package</uri></include>

  </world>
</sdf>
